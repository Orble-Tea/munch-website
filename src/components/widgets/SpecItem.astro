---
const { title } = Astro.props;
---

<div class="flex items-center gap-4 lg:gap-6">
  <!-- Icon circle -->
  <div class="flex-shrink-0 w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#B1D9CD] flex items-center justify-center text-white">
    <slot name="icon" />
  </div>

  <!-- Text -->
  <div class="text-left">
    <h3 class="text-base lg:text-lg tracking-normal">
      <span class="font-bold">{title}:</span>
      <slot />
    </h3>
  </div>
</div>
